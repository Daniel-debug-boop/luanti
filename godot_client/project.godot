; Engine configuration file.
; Godot 4.4 — Luanti world viewer / migration target.

config_version=5

[application]

config/name="LuantiVoxel (Godot 4 migration)"
config/description="Loads Luanti worlds (map.sqlite, format 29) and renders them with greedy-meshed voxel chunks."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; The UI is authored against 1280x720 and `canvas_items` scales it with the
; window. `expand` (rather than the default `keep`) is what makes an ultrawide
; or a 4:3 window actually usable: with `keep` the picture is letterboxed and
; the extra width is thrown away, and edge-anchored panels sit inside the
; pillarbox instead of at the real screen edge.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true

